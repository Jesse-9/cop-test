# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
/.superpowers/
wheels/
*.egg-info

# Virtual environments
.venv

# CoppeliaSim 场景文件 (体积大, 仅显式跟踪 factory-sim.ttt 与场景工件)
*.ttt
!factory-sim.ttt
!docs/scene_artifacts/**/scene.ttt

# 场景生命周期运行时状态/锁 (每次运行重新生成)
docs/scene_artifacts/.runtime/

# 运行日志与紧急转储 (每次运行重新生成, 不纳入版本控制)
factory_sim.log
factory_verify_*.log
factory_arm_*.log
stage1*.log
stage2*.log
stage3*.log
step1_1*.log
coppelia_console*.log*
emergency_dump_*.json

# 运行输出与测试临时目录 (证据按需归档到 docs/implementation/evidence/)
docs/implementation/runs/
.pytest-tmp/

# 文档库的 Obsidian 本地状态与插件 (不入库)
docs/.obsidian/
docs/.claudian/
docs/.claude/
docs/raw/
