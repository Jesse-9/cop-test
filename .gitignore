# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
/.superpowers/
wheels/
*.egg-info

# Virtual environments
.venv

# CoppeliaSim 场景文件 (体积大, 仅显式跟踪场景工件)
*.ttt
!docs/scene_artifacts/**/scene.ttt

# 场景生命周期运行时状态/锁 (每次运行重新生成)
docs/scene_artifacts/v1/.runtime/

# 运行日志与紧急转储 (每次运行重新生成, 不纳入版本控制)
flexible_factory*.log
coppelia_console*.log*
stage2_harness.log
emergency_dump_*.json
logs/

# 运行输出与测试临时目录 (证据按需归档到 docs/implementation/evidence/)
docs/implementation/runs/
.pytest-tmp/
/.tmp/
# 本地目录数据库 (按需重建; 不进入版本控制, 不写入场景工件目录)
/var/

# 本地 Neo4j 凭据与临时导入文件
/tools/neo4j/.env
/tools/neo4j/import/*
!/tools/neo4j/import/.gitkeep

# 用户提供的本地参考 dump/脚本 (可能含凭据, 不纳入版本控制)
/ref/

# 本地工作区记忆与助手状态 (不入库)
/.workbuddy/

# 文档库的 Obsidian 本地状态与插件 (不入库)
docs/.obsidian/
docs/.claudian/
docs/.claude/
docs/raw/

# 前端 workspace 依赖与构建/测试产物 (锁文件入库)
frontend/node_modules/
frontend/dist/
frontend/test-results/
frontend/playwright-report/
frontend/.vite/

