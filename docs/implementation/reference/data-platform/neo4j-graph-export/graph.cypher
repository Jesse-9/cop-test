CREATE (n58:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:150", `pro_工艺产物`: "具有平整表面和精确尺寸的=", `pro_所需设备`: "铣刀、铣床、数控铣床", `pro_父工艺`: "铣削工艺", `pro_常见异常`: "刀具磨损、工件固定不稳、切削力过大", `pro_工艺描述`: "在工件表面上进行平面轮廓加工，通常使用平面铣刀。", `name`: "平面铣削工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "平面、曲面、倒角、孔等工件", `pro_工艺编号`: "1.1.3.1", `pro_注意事项`: "选择合适的铣刀类型和切削参数，根据工件材料和要求确定合适的切削速度和进给率。\n定期检查和更换磨损严重的铣刀，以保持切削效果和加工质量。\n确保工件在工作台上得到良好的固定和夹紧，以避免加工中的位移或震动。\n避免过大的切削力，以防止刀具断裂或工件损坏。\n注意安全操作，戴上适当的防护眼镜和手套，避免发生事故和受伤。\n", `pro_工艺对象`: "金属，塑料，木材"});
CREATE (n59:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:151", `pro_工艺产物`: "具有平滑曲面和精确尺寸的=", `pro_所需设备`: "铣刀、数控铣床、曲面铣床", `pro_父工艺`: "铣削工艺", `pro_常见异常`: "刀具磨损、切削力过大、加工表面质量不达标", `pro_工艺描述`: "用铣刀在工件表面上进行复杂曲面的加工。", `name`: "曲面铣削工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "复杂曲面工件", `pro_工艺编号`: "1.1.3.2", `pro_注意事项`: "选择合适的刀具类型和切削参数，根据工件材料和要求确定合适的切削速度和进给率。\n定期检查和更换磨损严重的刀具，以保持切削效果和加工质量。\n控制切削力，避免过大的切削力，以防止刀具断裂或工件变形。\n注意加工表面的质量，避免出现划痕、毛刺等缺陷。\n进行必要的刀具路径规划和工艺优化，以提高加工效率和质量。", `pro_工艺对象`: "金属，塑料，木材"});
CREATE (n60:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:152", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_常见异常`: "null", `pro_工艺描述`: "旋转工件，切削刀具与工件表面之间形成相对运动。", `name`: "车削工艺", `pro_所需环境`: "null", `pro_常见用途`: "null", `pro_工艺编号`: "1.1.4", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n61:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:153", `pro_工艺产物`: "具有平整表面和精确尺寸的圆柱形工件。", `pro_所需设备`: "车床、数控车床", `pro_父工艺`: "车削工艺", `pro_常见异常`: "刀具磨损、工件固定不稳、切削力过大", `pro_工艺描述`: "切削刀具与工件轴线平行进行车削。适用于对工件外表面进行精确加工和尺寸控制。", `name`: "平行车削工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "轴、销、螺纹杆", `pro_工艺编号`: "1.1.4.1", `pro_注意事项`: "选择合适的切削刀具和切削参数，根据工件材料和要求确定合适的切削速度和进给率。\n 定期检查和更换磨损严重的刀具，以保持切削效果和加工质量。\n确保工件在工作台上得到良好的夹持和固定，以避免加工中的位移或震动。\n避免过大的切削力，以防止刀具断裂或工件损坏。\n注意安全操作，戴上适当的防护眼镜和手套，避免发生事故和受伤。\n", `pro_工艺对象`: "圆柱形工件"});
CREATE (n62:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:154", `pro_工艺产物`: "具有平整表面和精确尺寸的端面和平面工件", `pro_所需设备`: "车床、数控车床", `pro_父工艺`: "车削工艺", `pro_常见异常`: "刀具磨损、工件固定不稳、切削力过大", `pro_工艺描述`: "切削刀具与工件轴线垂直进行车削。", `name`: "垂直车削工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "平板、盘件、法兰", `pro_工艺编号`: "1.1.4.2", `pro_注意事项`: "选择合适的切削刀具和切削参数，根据工件材料和要求确定合适的切削速度和进给率。\n定期检查和更换磨损严重的刀具，以保持切削效果和加工质量。\n确保工件在工作台上得到良好的夹持和固定，以避免加工中的位移或震动。\n避免过大的切削力，以防止刀具断裂或工件损坏。\n注意安全操作，戴上适当的防护眼镜和手套，避免发生事故和受伤。", `pro_工艺对象`: "端面和平面工件"});
CREATE (n63:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:155", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_常见异常`: "null", `pro_工艺描述`: "通过刨刀对工件表面进行切削，实现平面或轮廓加工。", `name`: "刨削工艺", `pro_所需环境`: "null", `pro_常见用途`: "null", `pro_工艺编号`: "1.1.5", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n64:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:156", `pro_工艺产物`: "具有平整表面和精确尺寸的平面工件", `pro_所需设备`: "刨床、数控刨床", `pro_父工艺`: "刨削工艺", `pro_常见异常`: "刀具磨损、工件固定不稳、切削力过大", `pro_工艺描述`: "对工件表面进行平面加工，获得平整的表面。", `name`: "平面刨削工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "平板、底座、支撑面工件", `pro_工艺编号`: "1.1.5.1", `pro_注意事项`: "选择合适的切削刀具和切削参数，根据工件材料和要求确定合适的切削速度和进给率。\n定期检查和更换磨损严重的刀具，以保持切削效果和加工质量。\n确保工件在工作台上得到良好的夹持和固定，以避免加工中的位移或震动。\n避免过大的切削力，以防止刀具断裂或工件损坏。\n注意安全操作，戴上适当的防护眼镜和手套，避免发生事故和受伤。", `pro_工艺对象`: "平面表面工件"});
CREATE (n65:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:157", `pro_工艺产物`: "具有精确轮廓形状和尺寸的工件", `pro_所需设备`: "轮廓刨床、数控刨床", `pro_父工艺`: "刨削工艺", `pro_常见异常`: "刀具磨损、工件固定不稳、切削力过大", `pro_工艺描述`: "根据特定的轮廓要求，对工件表面进行刨削，获得所需形状的轮廓。", `name`: "轮廓刨削工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "曲线模具、齿轮、曲线表面工件", `pro_工艺编号`: "1.1.5.2", `pro_注意事项`: "定期检查和维护刀具和设备，确保其正常运行和切削效果。\n控制切削参数，如刀具切削速度、进给速度和切削深度，以获得理想的表面质量和尺寸精度。\n确保工件夹持牢固和稳定，避免切削过程中的振动和变形。\n使用适当的冷却液或润滑剂，以降低切削温度、延长刀具寿命，并提高切削质量。 定期进行工件尺寸和表面质量的检测和验证，以确保符合要求。", `pro_工艺对象`: "复杂轮廓形状工件"});
CREATE (n66:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:158", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "成型工艺", `pro_常见异常`: "null", `pro_工艺描述`: "对金属材料施加压力和热力来改变其形状和性能。", `name`: "锻造工艺", `pro_所需环境`: "null", `pro_物理化学`: "物理", `pro_常见用途`: "null", `pro_工艺编号`: "1.2.1", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n67:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:159", `pro_工艺产物`: "具有各种形状的金属工件", `pro_所需设备`: "锤锻机", `pro_父工艺`: "锻造工艺", `pro_常见异常`: "金属材料的裂纹、气孔、尺寸偏差", `pro_工艺描述`: "使用锤类设备（如锤机）施加冲击和压力，将金属材料塑性变形为所需形状。", `name`: "锤锻工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "锻造轴类零件、锻造齿轮、锻造连杆、锻造法兰", `pro_工艺编号`: "1.2.1.1", `pro_注意事项`: "控制锤锻的冲击力度和频率,以确保金属材料具有良好的塑性和流动性。\n对于大型工件或复杂形状的工件,需要进行预热和均热处理,以减少应力和变形。\n确保锤锻机的稳定性和精确性,以获得一致的工件质量。\n定期检查和维护锤锻模具,以保持其几何形状和表面质量。\n注意工人的安全防护,如戴上防护眼镜、手套和护具,避免事故和受伤。", `pro_工艺对象`: "小批量金属工件"});
