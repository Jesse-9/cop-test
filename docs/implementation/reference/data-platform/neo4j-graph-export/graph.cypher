CREATE (n93:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:182", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "热处理工艺", `pro_常见异常`: "null", `pro_工艺描述`: "将金属材料迅速冷却以增加其硬度和强度。", `name`: "淬火工艺", `pro_所需环境`: "null", `pro_物理化学`: "物理+化学", `pro_常见用途`: "null", `pro_工艺编号`: "2.1.1", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n94:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:183", `pro_工艺产物`: "具有较高的硬度和强度的金属材料", `pro_所需设备`: "淬火槽、水槽、喷淋系统", `pro_父工艺`: "淬火工艺", `pro_常见异常`: "热裂纹、变形、淬火不均匀", `pro_工艺描述`: "使用水作为冷却介质进行淬火，提供最大的冷却速度，适用于大部分钢材。", `name`: "水淬火", `pro_所需环境`: "高温，防氧化", `pro_物理化学`: "物理", `pro_常见用途`: "车辆零部件、工具、机械零件", `pro_工艺编号`: "2.1.1.1", `pro_注意事项`: "需要控制加热和冷却速度，避免过快的温度变化。\n考虑材料的尺寸稳定性和形状设计。\n需要进行适当的工艺调整和优化使不同部位的冷却速度均匀。", `pro_工艺对象`: "大多数金属材料"});
CREATE (n95:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:184", `pro_工艺产物`: "具有较高的硬度和强度的金属材料", `pro_所需设备`: "淬火槽、油槽、泵浦系统", `pro_父工艺`: "淬火工艺", `pro_常见异常`: "热裂纹、变形、淬火不均匀、油质污染", `pro_工艺描述`: "使用油作为冷却介质进行淬火，提供中等冷却速度，适用于某些钢材和较大尺寸的工件。", `name`: "油淬火", `pro_所需环境`: "高温，防氧化", `pro_物理化学`: "物理", `pro_常见用途`: "工具、模具、机械零件", `pro_工艺编号`: "2.1.1.2", `pro_注意事项`: "根据金属材料和产品要求，选择适合的油介质，以获得期望的淬火效果。\n防止火灾和人身伤害的发生。\n控制加热温度、保温时间和淬火介质温度，以确保淬火效果和产品质量的稳定性。", `pro_工艺对象`: "含碳量高钢材"});
CREATE (n96:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:185", `pro_工艺产物`: "具有较高的硬度和强度的金属材料", `pro_所需设备`: "淬火槽、水槽、喷淋系统", `pro_父工艺`: "淬火工艺", `pro_常见异常`: "淬火裂纹、淬火不均匀", `pro_工艺描述`: "使用溶剂（水）与其他添加剂（如聚合物、盐等）混合而成的溶液作为冷却介质，提供控制冷却速度的能力，适用于特定的材料和要求。", `name`: "溶液淬火", `pro_所需环境`: "高温，防氧化", `pro_物理化学`: "物理", `pro_常见用途`: "工具、模具、汽车零部件", `pro_工艺编号`: "2.1.1.3", `pro_注意事项`: "根据金属材料类型和要求，选择合适的淬火介质，以获得期望的淬火效果。\n确保金属材料加热和淬火介质温度的准确控制，以避免过热或过冷造成的问题。\n操作人员应严格遵守安全操作规程，避免火灾和人身伤害的发生。\n根据金属材料的特性和要求，进行适当的加热温度、保温时间和淬火介质温度的控制。", `pro_工艺对象`: "特殊合金材料"});
CREATE (n97:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:186", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "热处理工艺", `pro_常见异常`: "null", `pro_工艺描述`: "将金属材料加热到适当温度并保持一段时间，然后缓慢冷却。", `name`: "退火工艺", `pro_所需环境`: "null", `pro_物理化学`: "物理+化学", `pro_常见用途`: "null", `pro_工艺编号`: "2.1.2", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n98:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:187", `pro_工艺产物`: "具有较低的硬度和较高的韧性的金属材料", `pro_所需设备`: "热处理炉、冷却设备", `pro_父工艺`: "退火工艺", `pro_常见异常`: "过退火，退火不均匀", `pro_工艺描述`: "将材料加热到高于临界温度并保持一段时间，然后缓慢冷却至室温。//消除内部应力//提高晶粒的均匀性 //改善材料的可加工性//", `name`: "全退火", `pro_所需环境`: "高温，防氧化", `pro_物理化学`: "物理", `pro_常见用途`: "零部件、工具、模具", `pro_工艺编号`: "2.1.2.1", `pro_注意事项`: "严格控制加热温度和保温时间，避免过退火或不均匀退火的发生。\n根据材料要求，选择适当的冷却介质。\n保持热处理环境的清洁，避免材料表面的污染和氧化。", `pro_工艺对象`: "碳钢、合金钢、不锈钢、铝合金"});
CREATE (n99:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:188", `pro_工艺产物`: "具有特定性质的金属材料", `pro_所需设备`: "热处理炉、温控设备、冷却设备", `pro_父工艺`: "退火工艺", `pro_常见异常`: "过退火，退火不均匀", `pro_工艺描述`: "将材料加热到超过临界温度，然后以空气快速冷却。//提高材料的硬度和强度//使晶粒更细小//减少应力。", `name`: "规则退火", `pro_所需环境`: "高温，防氧化", `pro_物理化学`: "物理", `pro_常见用途`: "零部件、工具、模具", `pro_工艺编号`: "2.1.2.2", `pro_注意事项`: "严格控制加热温度和保温时间，避免过退火或不均匀退火的发生。\n根据材料要求，选择适当的冷却介质。\n保持热处理环境的清洁，避免材料表面的污染和氧化。", `pro_工艺对象`: "碳钢、合金钢、不锈钢、铝合金"});
CREATE (n100:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:189", `pro_工艺产物`: "具有更好可加工性的金属材料", `pro_所需设备`: "热处理炉、温控设备、冷却设备", `pro_父工艺`: "退火工艺", `pro_常见异常`: "过退火，退火不均匀", `pro_工艺描述`: "在冷变形之前对材料进行退火处理。//减轻材料的硬度//改善可塑性//并为后续的冷变形工艺做准备。", `name`: "预退火", `pro_所需环境`: "高温，防氧化", `pro_物理化学`: "物理", `pro_常见用途`: "零部件、工具、模具", `pro_工艺编号`: "2.1.2.3", `pro_注意事项`: "严格控制加热温度和保温时间，避免过退火或不均匀退火的发生。\n根据材料要求，选择适当的冷却介质。\n保持热处理环境的清洁，避免材料表面的污染和氧化。", `pro_工艺对象`: "碳钢、合金钢、不锈钢、铝合金"});
