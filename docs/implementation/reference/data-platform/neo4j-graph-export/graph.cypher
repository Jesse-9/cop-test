CREATE (n84:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:174", `pro_工艺产物`: "注塑成型后的聚丙烯制品", `pro_所需设备`: "注塑机、模具、熔融机、冷却系统", `pro_父工艺`: "热塑性注塑工艺", `pro_常见异常`: "熔融不均匀、气泡、毛边、收缩", `pro_工艺描述`: "使用聚丙烯塑料进行注塑制造，用于制作各种塑料制品。", `name`: "聚丙烯（PP）注塑", `pro_所需环境`: "高温\n高压", `pro_物理化学`: "物理", `pro_常见用途`: "家居用品、\n家电外壳、\n汽车部件、\n工业部件", `pro_工艺编号`: "1.2.3.1.1", `pro_注意事项`: "选择适当的注塑机和模具，以满足产品的尺寸和要求。\n控制注塑机的温度、压力和注射速度等参数，确保熔融聚丙烯的均匀注入和充填。\n定期检查和维护注塑设备和模具，确保其正常运行和准确性。\n调整冷却系统以控制产品的冷却速度和收缩率。\n操作人员应接受相关培训，熟悉操作规程，并遵守安全操作规范。", `pro_工艺对象`: "聚丙烯"});
