CREATE (n102:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:190", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "热处理工艺", `pro_常见异常`: "null", `pro_工艺描述`: "将淬火后的金属材料再次加热到适当温度，然后进行适当的冷却。", `name`: "回火工艺", `pro_所需环境`: "null", `pro_物理化学`: "物理+化学", `pro_常见用途`: "null", `pro_工艺编号`: "2.1.3", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n103:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:191", `pro_工艺产物`: "具有更好韧性，抗冲击性的金属材料", `pro_所需设备`: "热处理炉、温控设备、冷却设备", `pro_父工艺`: "回火工艺", `pro_常见异常`: "过回火、不均匀回火", `pro_工艺描述`: "低温回火是在相对较低的温度范围内进行的回火处理，通常在200°C以下。//保持材料的硬度和强度的同时提高韧性和抗冲击性。", `name`: "低温回火", `pro_所需环境`: "高温，防氧化", `pro_物理化学`: "物理", `pro_常见用途`: "刀具、模具、汽车零部件", `pro_工艺编号`: "2.1.3.1", `pro_注意事项`: "严格控制加热温度和保温时间，避免过回火或不均匀回火的发生。\n根据材料要求，选择适当的冷却介质。\n保持热处理环境的清洁，避免材料表面的污染和氧化。", `pro_工艺对象`: "高碳钢、合金钢、工具钢"});
CREATE (n104:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:192", `pro_工艺产物`: "具有更好韧性，可塑性的金属材料", `pro_所需设备`: "热处理炉、温控设备、冷却设备", `pro_父工艺`: "回火工艺", `pro_常见异常`: "过回火、不均匀回火", `pro_工艺描述`: "中温回火是在中等温度范围内进行的回火处理，通常在200°C至500°C之间。//减轻材料的硬度和强度//提供更好的韧性和可塑性。", `name`: "中温回火", `pro_所需环境`: "高温，防氧化", `pro_物理化学`: "物理", `pro_常见用途`: "机械零部件、工具", `pro_工艺编号`: "2.1.3.2", `pro_注意事项`: "严格控制加热温度和保温时间，避免过回火或不均匀回火的发生。\n根据材料要求，选择适当的冷却介质。\n保持热处理环境的清洁，避免材料表面的污染和氧化。", `pro_工艺对象`: "低合金钢、碳钢、铸铁"});
CREATE (n105:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:193", `pro_工艺产物`: "具有更好韧性，延展性的金属材料", `pro_所需设备`: "热处理炉、温控设备、冷却设备", `pro_父工艺`: "回火工艺", `pro_常见异常`: "过回火、不均匀回火", `pro_工艺描述`: "高温回火是在相对较高的温度范围内进行的回火处理，通常在500°C以上。//降低材料的硬度和强度//提高韧性//并减少内部应力。", `name`: "高温回火", `pro_所需环境`: "高温，防氧化", `pro_物理化学`: "物理", `pro_常见用途`: "航空航天部件、石油化工设备", `pro_工艺编号`: "2.1.3.3", `pro_注意事项`: "严格控制加热温度和保温时间，避免过回火或不均匀回火的发生。\n根据材料要求，选择适当的冷却介质。\n保持热处理环境的清洁，避免材料表面的污染和氧化。", `pro_工艺对象`: "不锈钢、高合金钢、热作模具钢"});
CREATE (n106:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:194", `pro_工艺产物`: "具有更精确硬度、韧性和机械性能的金属材料", `pro_所需设备`: "热处理炉、温控设备、冷却设备", `pro_父工艺`: "回火工艺", `pro_常见异常`: "过回火、不均匀回火", `pro_工艺描述`: "多次回火是对材料进行多次回火处理，每次回火的温度和时间可以有所不同。//更精确地调节材料的性能//平衡硬度、韧性和强度的关系。", `name`: "多次回火", `pro_所需环境`: "高温，防氧化", `pro_物理化学`: "物理", `pro_常见用途`: "特殊要求工件", `pro_工艺编号`: "2.1.3.4", `pro_注意事项`: "严格控制各阶段加热温度和保温时间，避免过回火或不均匀回火的发生。\n根据材料要求，选择适当的冷却介质。\n保持热处理环境的清洁，避免材料表面的污染和氧化。", `pro_工艺对象`: "钢材、合金钢、工具钢"});
CREATE (n107:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:195", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "表面处理工艺", `pro_常见异常`: "null", `pro_工艺描述`: "通过机械或化学方法，使金属表面光滑、平整并去除表面缺陷。", `name`: "抛光工艺", `pro_所需环境`: "null", `pro_物理化学`: "物理+化学", `pro_常见用途`: "null", `pro_工艺编号`: "2.2.1", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n108:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:196", `pro_工艺产物`: "具有良好的外观和触感的制品", `pro_所需设备`: "抛光机、研磨片", `pro_父工艺`: "抛光工艺", `pro_常见异常`: "研磨片磨损、过度磨削、磨削痕迹", `pro_工艺描述`: "使用机械力和磨料材料来去除材料表面的凹凸不平和瑕疵，实现光洁度的提高。", `name`: "机械抛光工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "各种外壳部件", `pro_工艺编号`: "2.2.1.1", `pro_注意事项`: "\n选择合适的研磨液和研磨片，以适应不同材料和加工要求。\n控制研磨参数，如速度、压力和时间，以确保一致的抛光效果和避免过度磨削。\n定期检查和维护抛光设备，确保其正常运行和操作安全。\n遵循相关的操作规程和安全指南，使用个人防护设备，如护目镜、手套等。", `pro_工艺对象`: "金属零件、陶瓷、玻璃、塑料制品"});
CREATE (n109:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:197", `pro_工艺产物`: "具有光洁外观金属材料", `pro_所需设备`: "抛光液、清洗设备", `pro_父工艺`: "抛光工艺", `pro_常见异常`: "蚀削不均匀、化学品溅出", `pro_工艺描述`: "利用特定的化学溶液或腐蚀剂，使材料表面的不均匀层或氧化层溶解，获得光滑、平整的表面。//用于一些难以通过机械抛光去除的材料或复杂形状的工件。", `name`: "化学抛光工艺", `pro_所需环境`: "通风良好避免有害气体聚集\n温度控制\n常压", `pro_物理化学`: "化学", `pro_常见用途`: "各种金属外壳部件", `pro_工艺编号`: "2.2.1.2", `pro_注意事项`: "选择适合的化学抛光液和操作方法，根据具体材料和要求进行合理的抛光处理。\n严格控制化学抛光液的浓度、温度和处理时间，以避免过度腐蚀和损坏物体表面。\n在进行化学抛光操作时，应遵循相关的安全操作规程和操作指南，使用个人防护设备，确保操作人员的安全。", `pro_工艺对象`: "表面有氧化层的金属材料"});
CREATE (n110:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:198", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "表面处理工艺", `pro_常见异常`: "null", `pro_工艺描述`: "为材料提供功能性外涂层。", `name`: "喷涂工艺", `pro_所需环境`: "null", `pro_常见用途`: "null", `pro_工艺编号`: "2.2.2", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n111:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:199", `pro_工艺产物`: "具有均匀的涂层的制品", `pro_所需设备`: "喷枪、压缩气罐、涂料泵", `pro_父工艺`: "喷涂工艺", `pro_常见异常`: "喷涂不均匀、涂料流挂、气泡、鱼眼", `pro_工艺描述`: "将涂料以气体或压力喷雾的形式喷洒到物体表面的涂覆过程。//提供装饰性和保护性涂层。", `name`: "喷漆", `pro_所需环境`: "通风良好避免有害气体聚集、\n温度控制\n", `pro_物理化学`: "物理", `pro_常见用途`: "各种外壳部件", `pro_工艺编号`: "2.2.2.1", `pro_注意事项`: "选择适合的喷漆设备和涂料类型，根据物体材质和要求确定合适的喷漆工艺。\n控制喷漆压力、喷漆距离和喷涂速度，以获得均匀的涂层。\n在喷漆前，确保物体表面清洁、干燥和光滑，以确保涂层附着良好。", `pro_工艺对象`: "金属、塑料、木制品、玻璃"});
CREATE (n112:`Abstraction` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:2", `name`: "机器人"});
CREATE (n113:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:20", `name`: "前后配重块组件", `pro_code`: "BPZA0001"});
CREATE (n114:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:200", `pro_工艺产物`: "具有均匀的涂层的制品", `pro_所需设备`: "喷粉枪、粉末涂料供应系统", `pro_父工艺`: "喷涂工艺", `pro_常见异常`: "粉末涂层不均匀、\n粉末涂层厚度不均匀、\n颗粒聚集", `pro_工艺描述`: "将粉末状的涂料通过静电吸附的方式喷洒到物体表面，然后在烘烤过程中使其熔化和固化形成涂层。//用于金属制品、家具、电器等领域，提供耐磨、耐腐蚀和美观的涂层。", `name`: "喷粉", `pro_所需环境`: "通风良好避免有害气体聚集、\n温度控制", `pro_物理化学`: "物理", `pro_常见用途`: "各种金属外壳部件", `pro_工艺编号`: "2.2.2.2", `pro_注意事项`: "选择适合的喷粉设备和粉末涂料类型，根据物体材质和要求确定合适的喷粉工艺。\n控制喷粉压力、喷粉距离和喷粉速度，以获得均匀的粉末涂层。在喷粉前，确保物体表面清洁、干燥和光滑，以确保涂层附着良好。", `pro_工艺对象`: "金属、塑料、木制品、玻璃"});
CREATE (n115:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:201", `pro_工艺产物`: "具有保护、改性或装饰涂层的工件", `pro_所需设备`: "火焰喷枪、等离子喷枪", `pro_父工艺`: "喷涂工艺", `pro_常见异常`: "涂层附着力差", `pro_工艺描述`: "将熔融或部分熔融的涂料材料以喷射方式喷洒到物体表面，形成涂层。热喷涂工艺包括火焰喷涂、等离子喷涂、电弧喷涂等//用于提供高温耐受、耐磨、耐腐蚀的涂层。", `name`: "热喷涂", `pro_所需环境`: "通风良好避免有害气体聚集、\n高温", `pro_物理化学`: "物理", `pro_常见用途`: "金属涂层、陶瓷涂层、聚合物涂层", `pro_工艺编号`: "2.2.2.3", `pro_注意事项`: "确保操作人员具备专业的热喷涂技术知识和经验。\n根据不同的喷涂材料和工艺要求，选择合适的喷涂设备和喷涂参数。\n注意操作安全，避免火源和高温对周围环境和人身安全的影响。\n进行涂层质量检测和性能测试，以确保涂层的质量和符合要求。", `pro_工艺对象`: "金属材料"});
CREATE (n116:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:202", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "表面处理工艺", `pro_常见异常`: "null", `pro_工艺描述`: "使材料表面获得均匀的磨砂效果。", `name`: "磨砂工艺", `pro_所需环境`: "null", `pro_常见用途`: "各种金属外壳部件", `pro_工艺编号`: "2.2.3", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n117:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:203", `pro_工艺产物`: "提高或降低粗糙度的工件", `pro_所需设备`: "磨砂机、砂磨材料、冷却系统", `pro_父工艺`: "磨砂工艺", `pro_常见异常`: "磨削不均匀、磨损过度、热影响区域", `pro_工艺描述`: "使用机械设备，如砂纸、砂轮或磨砂机，通过物理摩擦力将磨砂材料施加到物体表面进行磨削。", `name`: "机械磨砂工艺", `pro_所需环境`: "通风良好、温度控制", `pro_物理化学`: "物理", `pro_常见用途`: "各种外壳部件", `pro_工艺编号`: "2.2.3.1", `pro_注意事项`: "操作人员需佩戴适当的个人防护装备，如护目镜、防尘口罩、耳塞等。\n根据物体材料和要求选择合适的磨砂工艺和磨削参数。\n定期检查和维护磨砂设备，确保其正常运行和安全性能。\n遵循相关的安全操作规程，避免意外伤害和环境污染。", `pro_工艺对象`: "金属，塑料，石材"});
CREATE (n118:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:204", `pro_工艺产物`: "提高或降低粗糙度的工件", `pro_所需设备`: "磨砂液容器、涂布工具", `pro_父工艺`: "磨砂工艺", `pro_常见异常`: "蚀刻过度、处理不均匀", `pro_工艺描述`: "使用化学溶液或腐蚀剂对物体表面进行处理，去除表面的凹凸不平和获得均匀的磨砂效果。//用于一些难以通过机械磨砂处理的材料或复杂形状的工件。", `name`: "化学磨砂工艺", `pro_所需环境`: "通风良好、温度控制", `pro_物理化学`: "化学", `pro_常见用途`: "各种外壳部件", `pro_工艺编号`: "2.2.3.2", `pro_注意事项`: "操作人员需佩戴适当的个人防护装备，如护目镜、防护手套等。\n严格按照化学磨砂液的使用说明和安全操作规程进行操作。\n控制化学磨砂液的浓度和处理时间，以避免过度腐蚀或不均匀处理。\n处理后及时清洗物体表面，以去除残留的化学磨砂液和产物。", `pro_工艺对象`: "金属，玻璃"});
CREATE (n119:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:205", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "表面处理工艺", `pro_常见异常`: "null", `pro_工艺描述`: "通过电化学方法在金属表面上沉积一层金属或合金。", `name`: "电镀工艺", `pro_所需环境`: "null", `pro_常见用途`: "null", `pro_工艺编号`: "2.2.4", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n120:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:206", `pro_工艺产物`: "带有金属镀层的制品", `pro_所需设备`: "电解槽、电源、电解液", `pro_父工艺`: "电镀工艺", `pro_常见异常`: "镀层不均匀、电解液污染、金属离子浓度变化", `pro_工艺描述`: "在电解槽中将金属离子还原到物体表面形成金属镀层。电解镀广泛应用于各种金属//镀铬、镀铜、镀镍、镀锌等//提供装饰性和防腐蚀的涂层。", `name`: "电解镀", `pro_所需环境`: "通风良好、温度控制", `pro_物理化学`: "化学", `pro_常见用途`: "表面保护、装饰、修复", `pro_工艺编号`: "2.2.4.1", `pro_注意事项`: "操作人员需佩戴适当的个人防护装备，如护目镜、防护手套等。\n严格按照电解液的使用说明和安全操作规程进行操作。\n控制电解液的温度、浓度和电流密度等参数，以获得所需的镀层质量。\n定期检查和维护电解槽和电源设备，确保其正常运行和安全性能。", `pro_工艺对象`: "需要表面具有金属层的制品"});
CREATE (n121:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:207", `pro_工艺产物`: "带有金属镀层的制品", `pro_所需设备`: "化学镀液、涂布设备", `pro_父工艺`: "电镀工艺", `pro_常见异常`: "镀层不均匀、镀液污染、化学反应不稳定", `pro_工艺描述`: "无电解的自催化镀层形成方法，通过在化学反应中使用特殊的还原剂将金属离子还原到物体表面形成金属镀层。//适用于各种复杂形状的工件和非导电材料//常用于金属、塑料、陶瓷等表面的涂层。", `name`: "化学镀", `pro_所需环境`: "通风良好、温度控制", `pro_物理化学`: "化学", `pro_常见用途`: "表面保护、装饰、修复", `pro_工艺编号`: "2.2.4.2", `pro_注意事项`: "操作人员需佩戴适当的个人防护装备，如护目镜、防护手套等。\n严格按照化学镀液的使用说明和安全操作规程进行操作。\n控制化学镀液的温度、浓度和操作时间等参数，以获得所需的镀层质量。\n定期检查和维护化学镀液的成分和质量，确保其正常运行和安全性能。", `pro_工艺对象`: "需要表面具有金属层的制品"});
CREATE (n122:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:208", `pro_工艺产物`: "表面形成各种颜色的铝制品", `pro_所需设备`: "电解槽、电源、电解液", `pro_父工艺`: "电镀工艺", `pro_常见异常`: "颜色不均匀、电解液污染、处理时间控制不当", `pro_工艺描述`: "通过在电解液中控制金属离子的氧化状态，形成彩色的金属氧化膜。//铝材表面处理获得不同的颜色和装饰效果。", `name`: "电解颜色", `pro_所需环境`: "通风良好、温度控制", `pro_物理化学`: "化学", `pro_常见用途`: "装饰效果、防腐蚀", `pro_工艺编号`: "2.2.4.3", `pro_注意事项`: "操作人员需佩戴适当的个人防护装备，如护目镜、防护手套等。\n严格按照电解液的使用说明和安全操作规程进行操作。\n控制电解液的温度、浓度和电流密度等参数，以获得所需的颜色效果。\n定期检查和维护电解槽和电源设备，确保其正常运行和安全性能。", `pro_工艺对象`: "铝制品"});
CREATE (n123:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:209", `pro_工艺产物`: "具有清洁表面的金属制品", `pro_所需设备`: "酸洗槽、酸洗液、清洗设备", `pro_父工艺`: "表面处理工艺", `pro_常见异常`: "酸液浓度不当、酸洗时间不当", `pro_工艺描述`: "使用酸性溶液对金属表面进行清洁和腐蚀去除，以去除氧化层、锈蚀、油脂和其他污染物//实现表面的清洁和净化。", `name`: "酸洗工艺", `pro_所需环境`: "通风良好、ph值控制", `pro_物理化学`: "化学", `pro_常见用途`: "表面清洁", `pro_工艺编号`: "2.2.5", `pro_注意事项`: "操作人员需佩戴适当的个人防护装备，如护目镜、防护手套等。\n根据具体酸洗液的性质，采取相应的安全措施，避免酸液的直接接触和飞溅。\n严格按照酸洗液的使用说明和安全操作规程进行操作。\n定期检查和维护酸洗槽和相关设备，确保其正常运行和安全性能。", `pro_工艺对象`: "表面生锈或污浊的金属制品"});
CREATE (n124:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:21", `name`: "前后连接法兰装配体", `pro_code`: "TFLA0001"});
CREATE (n125:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:210", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "机械连接", `pro_常见异常`: "null", `pro_工艺描述`: "通过压力或摩擦力来确保连接件的紧固。//常用于防止连接件在振动或负载下松动//如垫片，插销，锁扣等。", `name`: "锁紧连接", `pro_所需环境`: "null", `pro_物理化学`: "物理", `pro_常见用途`: "null", `pro_工艺编号`: "3.1.1", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n126:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:211", `pro_no_base_feature`: "外螺纹", `pro_父工艺`: "机械连接", `pro_所需环境`: "null", `pro_base_feature`: "内螺纹", `pro_工艺对象`: "null", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_常见异常`: "null", `pro_工艺描述`: "螺纹连接是通过螺纹结构将零件紧固在一起的连接方式。//常见的螺纹连接包括螺纹和螺栓、螺丝钉和螺纹孔等。//广泛用于机械装配、结构连接和设备安装中。", `name`: "螺纹连接", `pro_物理化学`: "物理", `pro_常见用途`: "null", `pro_工艺编号`: "3.1.2", `pro_注意事项`: "null"});
CREATE (n127:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:212", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "机械连接", `pro_常见异常`: "null", `pro_工艺描述`: "两个或以上齿轮通过齿与齿的咬合来传递力和运动。//通常使用键（如平键、半圆键）将齿轮固定在轴上，以确保齿轮与轴的同步旋转。//用于传递旋转运动和转矩的应用//例如机械设备、汽车传动系统、工业机械等。", `name`: "齿轮连接", `pro_所需环境`: "null", `pro_物理化学`: "物理", `pro_常见用途`: "null", `pro_工艺编号`: "3.1.3", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n128:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:213", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "机械连接", `pro_常见异常`: "null", `pro_工艺描述`: "通过使用钉、销或铆钉等零件将两个或多个零件固定在一起的连接方式。//常用于连接零件的旋转部分，如铰链、销轴等，以及需要频繁拆卸的连接。", `name`: "钉连接", `pro_所需环境`: "null", `pro_物理化学`: "物理", `pro_常见用途`: "null", `pro_工艺编号`: "3.1.4", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n129:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:214", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "粘接装配", `pro_常见异常`: "null", `pro_工艺描述`: "使用粘合剂将两个或多个零件黏合在一起的装配方法。//广泛应用于各种材料的连接，包括金属、塑料、玻璃等。胶粘剂装配通常具有较好的耐震动和耐腐蚀性能，并且可以实现多种材料之间的连接。", `name`: "粘合剂装配", `pro_所需环境`: "null", `pro_物理化学`: "物理+化学", `pro_常见用途`: "null", `pro_工艺编号`: "3.2.1", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n130:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:215", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "粘接装配", `pro_常见异常`: "null", `pro_工艺描述`: "通过加热零件自身使其融化，并在冷却后形成坚固连接的装配方法。//应用于金属零件连接//提供高强度和持久的连接//用于各种要求较高的结构和工程应用", `name`: "焊接", `pro_所需环境`: "null", `pro_物理化学`: "物理+化学", `pro_常见用途`: "null", `pro_工艺编号`: "3.2.2", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n131:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:216", `pro_工艺产物`: "形成稳定焊缝的组合部件", `pro_所需设备`: "大功率电源、焊接电极、夹具", `pro_父工艺`: "焊接", `pro_常见异常`: "焊渣、焊缝质量不良", `pro_工艺描述`: "利用电弧的高温和能量来融化工件并形成焊缝。//优点包括焊接速度快，适应性广，焊缝质量高。", `name`: "电弧焊", `pro_所需环境`: "通风良好、无易燃物、区域清洁", `pro_物理化学`: "物理+化学", `pro_常见用途`: "金属结构焊接、焊接修复", `pro_工艺编号`: "3.2.2.1", `pro_注意事项`: "操作人员需佩戴适当的个人防护装备。\n确保焊接设备和电源的安全性能，定期检查并及时维护。\n注意电弧焊操作的安全性，避免电弧接触皮肤、眼睛等敏感部位，预防电击和光电伤害。\n控制焊接电流、电压和焊接速度等参数。\n在焊接过程中保持焊接区域的干燥和清洁，避免杂质对焊缝质量的影响。", `pro_工艺对象`: "金属部件"});
CREATE (n132:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:217", `pro_工艺产物`: "形成稳定焊缝的组合部件", `pro_所需设备`: "焊枪、气瓶", `pro_父工艺`: "焊接", `pro_常见异常`: "焊渣、气孔、焊缝质量不良", `pro_工艺描述`: "气焊使用氧气和燃料气体（如乙炔）的燃烧产生高温火焰来加热和熔化工件，形成焊缝。//主要用于焊接钢铁材料。//优点包括设备简单、操作灵活，适用于室外环境。", `name`: "气体焊", `pro_所需环境`: "稀有气体保护", `pro_物理化学`: "物理+化学", `pro_常见用途`: "金属结构焊接、焊接修复", `pro_工艺编号`: "3.2.2.2", `pro_注意事项`: "操作人员需佩戴适当的个人防护装备，如焊接面罩、防护手套、防火服等。\n确保气体焊设备和气源的安全性能，定期检查并及时维护。\n控制焊接火焰的大小和温度，以保证焊接质量和焊缝的合理形状。\n使用适当的焊接材料和助焊剂，以提高焊接质量和工艺可靠性。\n在焊接过程中保持焊接区域的干燥和清洁，避免杂质对焊缝质量的影响。", `pro_工艺对象`: "金属部件"});
CREATE (n133:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:218", `pro_工艺产物`: "形成稳定焊缝的组合部件", `pro_所需设备`: "激光设备、夹具、控制系统", `pro_父工艺`: "焊接", `pro_常见异常`: "激光功率不均匀、\n热应力、气孔", `pro_工艺描述`: "使用激光束将工件表面局部加热至融化并形成焊缝。//主要用于金属材料的高要求工业应用。//优点包括高精度、小热影响区、无接触等。", `name`: "激光焊", `pro_所需环境`: "稀有气体保护", `pro_物理化学`: "物理+化学", `pro_常见用途`: "精密仪器制造", `pro_工艺编号`: "3.2.2.3", `pro_注意事项`: "操作人员需佩戴适当的个人防护装备。\n激光焊设备和系统需要经过专业培训的人员操作，确保安全性和操作规程的遵守。\n控制激光功率、焦点位置和扫描速度等参数，以保证焊接质量和焊缝的合理形状。\n确保焊接区域的清洁和干燥，避免杂质对焊缝质量的影响。\n对于特殊材料和工件，需要进行焊接工艺参数的优化和试验，以确保最佳的焊接结果。", `pro_工艺对象`: "金属部件"});
