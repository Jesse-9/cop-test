CREATE (n80:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:170", `pro_工艺产物`: "具有指定截面积和长度的工件", `pro_所需设备`: "拉伸机、模具、牵引轮", `pro_父工艺`: "拉伸工艺", `pro_常见异常`: "表面开裂、拉伸不均匀、材料断裂", `pro_工艺描述`: "在室温下进行拉伸，常用于钢材、铝材等金属材料的加工。", `name`: "冷拉伸工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "钢丝、钢管、螺纹杆", `pro_工艺编号`: "1.2.2.3.1", `pro_注意事项`: "选择适当的拉伸设备和模具,以获得所需的尺寸和性能要求。\n控制拉伸力、牵引速度等工艺参数,确保均匀的拉伸过程。\n定期检查和维护拉伸设备和模具,确保其准确性和稳定性。\n注意金属材料的性质和温度,避免超过其可承受的拉伸限制。\n操作人员应接受相关培训,熟悉操作规程,并遵守安全操作规范。", `pro_工艺对象`: "金属线材、金属管材、金属棒材"});
CREATE (n81:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:171", `pro_工艺产物`: "具有指定截面积和长度的工件", `pro_所需设备`: "拉伸机、加热炉、模具", `pro_父工艺`: "拉伸工艺", `pro_常见异常`: "拉伸过度、表面开裂、材料变形", `pro_工艺描述`: "在高温下进行拉伸，通过材料的高温塑性来实现形状变化，常用于高温合金、钛合金等材料的加工。", `name`: "热拉伸工艺", `pro_所需环境`: "高温", `pro_物理化学`: "物理", `pro_常见用途`: "汽车零部件、航空航天零部件、工程机械", `pro_工艺编号`: "1.2.2.3.2", `pro_注意事项`: "选择适当的热拉伸设备和模具，以满足所需的尺寸和性能要求。\n控制拉伸力、温度等工艺参数，确保合适的拉伸过程和温度控制。\n定期检查和维护热拉伸设备和模具，确保其准确性和稳定性。\n注意金属材料的热处理要求和温度范围，避免超过其可承受的热变形限制。\n操作人员应接受相关培训，熟悉操作规程，并遵守安全操作规范。", `pro_工艺对象`: "金属板材、金属型材、金属棒材"});
