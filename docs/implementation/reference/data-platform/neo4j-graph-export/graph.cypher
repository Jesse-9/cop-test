CREATE (n50:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:143", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "切削工艺", `pro_常见异常`: "null", `pro_工艺描述`: "旋转刀具与工件相对运动，对工件内部进行切削。", `name`: "镗削工艺", `pro_所需环境`: "null", `pro_物理化学`: "物理", `pro_常见用途`: "null", `pro_工艺编号`: "1.1.1", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n51:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:144", `pro_工艺产物`: "具有精确内孔的轴类零件", `pro_所需设备`: "旋转镗床、旋转镗削机、刀具", `pro_父工艺`: "镗削工艺", `pro_常见异常`: "刀具磨损、切削力过大、表面质量不理想等", `pro_工艺描述`: "刀具与工件同时旋转，切削内孔表面。", `name`: "旋转镗削工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "曲轴孔、主轴孔、轴承座", `pro_工艺编号`: "1.1.1.1", `pro_注意事项`: "使用合适的切削参数和刀具，以确保加工质量和工件寿命。\n定期检查刀具磨损情况，并及时更换刀具。\n确保设备和工件的稳定性，以避免切削振动和尺寸偏差。\n维护切削液系统，保持良好的冷却和润滑效果。", `pro_工艺对象`: "轴类零件"});
CREATE (n52:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:145", `pro_工艺产物`: "具有光洁，精确内孔的容器内壁，管道，筒体零件", `pro_所需设备`: "刮削镗床、刮削镗削机、刀具", `pro_父工艺`: "镗削工艺", `pro_常见异常`: "刀具磨损、切削力过大、表面质量不理想", `pro_工艺描述`: "采用刮削刀具进行镗削，刀具沿内孔轴线方向进行刮削，实现精密加工。", `name`: "刮削镗削工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "发动机气缸孔、液压缸内孔、管道和容器的内孔", `pro_工艺编号`: "1.1.1.2", `pro_注意事项`: "\n使用适当的切削参数和刀具，以确保加工质量和工件寿命。\n定期检查刀具磨损情况，并及时更换刀具。\n确保设备和工件的稳定性，以避免尺寸偏差和表面质量问题。\n维护切削液系统，保持良好的冷却和润滑效果。", `pro_工艺对象`: "容器内壁、管道、筒体"});
CREATE (n53:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:146", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "切削工艺", `pro_常见异常`: "null", `pro_工艺描述`: "推动旋转钻头进入工件内部。", `name`: "钻削工艺", `pro_所需环境`: "null", `pro_物理化学`: "物理", `pro_常见用途`: "null", `pro_工艺编号`: "1.1.2", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n54:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:147", `pro_工艺产物`: "具有圆形孔洞的=", `pro_所需设备`: "钻床，夹具，钻头", `pro_父工艺`: "钻削工艺", `pro_常见异常`: "钻头断裂、切削液不足、孔径偏大或偏小", `pro_工艺描述`: "通过旋转钻头在工件上切削圆形孔洞。", `name`: "钻孔工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "螺栓孔、螺纹孔、销孔和定位孔", `pro_工艺编号`: "1.1.2.1", `pro_注意事项`: "使用合适的钻头材料和类型,根据材料硬度选择适当的切削速度和进给率。\n定期检查和更换磨损严重的钻头,以确保切削效果和加工精度。\n使用冷却润滑剂或切削液来冷却和润滑钻头,以避免过热和延长钻头寿命。\n注意安全操作,戴上适当的防护眼镜和手套,避免发生事故和受伤。", `pro_工艺对象`: "金属，木材，复合材料"});
CREATE (n55:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:148", `pro_工艺产物`: "具有高精度、高表面质量的长形孔或深孔=", `pro_所需设备`: "深孔钻床、深孔钻削机、冷却润滑系统", `pro_父工艺`: "钻削工艺", `pro_常见异常`: "切屑堵塞、刀具磨损、切削液不足", `pro_工艺描述`: "通过旋转钻头在工件上切削长度远超直径的孔洞。", `name`: "长孔钻削工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "气缸套、导柱、导套、注塑模具中的冷却孔", `pro_工艺编号`: "1.1.2.2", `pro_注意事项`: "选择合适的刀具和切削参数,根据工件材料和要求确定合适的切削速度和进给率。\n定期检查和更换磨损严重的刀具,以确保切削效果和加工质量。\n使用适当的切削液和冷却系统,以冷却和润滑刀具,避免过热和延长刀具寿命。\n注意加工过程中的切削切屑排除,防止切屑堵塞导致加工质量下降或设备故障。", `pro_工艺对象`: "管道、轴类零件、模具"});
CREATE (n56:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:149", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "切削工艺", `pro_常见异常`: "null", `pro_工艺描述`: "旋转刀具与工件相对运动，对工件表面进行切削。", `name`: "铣削工艺", `pro_所需环境`: "null", `pro_物理化学`: "物理", `pro_常见用途`: "null", `pro_工艺编号`: "1.1.3", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
