CREATE (n69:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:160", `pro_工艺产物`: "具有各种形状的金属工件", `pro_所需设备`: "压力机", `pro_父工艺`: "锻造工艺", `pro_常见异常`: "金属材料的裂纹、气孔、尺寸偏差", `pro_工艺描述`: "使用压力机施加均匀和稳定的压力，将金属材料塑性变形为所需形状。", `name`: "压力机锻造工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "锻造轴类零件、锻造齿轮、锻造连杆、锻造法兰", `pro_工艺编号`: "1.2.1.2", `pro_注意事项`: "控制压力机的压力和运动速度，以确保金属材料具有良好的塑性和流动性。\n对于大型工件或复杂形状的工件，需要进行预热和均热处理，以减少应力和变形。\n确保压力机的稳定性和精确性，以获得一致的工件质量。\n定期检查和维护压力机模具，以保持其几何形状和表面质量。", `pro_工艺对象`: "大批量复杂金属工件"});
CREATE (n70:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:161", `pro_工艺产物`: "具有各种形状的金属工件", `pro_所需设备`: "液压机", `pro_父工艺`: "锻造工艺", `pro_常见异常`: "金属材料的裂纹、气孔、尺寸偏差", `pro_工艺描述`: "通过液压系统施加高压力，将金属材料塑性变形为所需形状。", `name`: "液压锻造工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "发动机部件、车轴、缸体", `pro_工艺编号`: "1.2.1.3", `pro_注意事项`: "控制液压锻造的压力和速度，以确保金属材料具有良好的塑性和流动性。\n对于大型工件或复杂形状的工件，需要进行预热和均热处理，以减少应力和变形。 \n确保液压锻造设备的稳定性和精确性，以获得一致的工件质量。\n定期检查和维护液压锻造模具，以保持其几何形状和表面质量。\n注意工人的安全防护，如戴上防护眼镜、手套和护具，避免事故和受伤。", `pro_工艺对象`: "大型金属工件"});
CREATE (n71:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:162", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "成型工艺", `pro_常见异常`: "null", `pro_工艺描述`: "对金属薄板进行各种加工，制作出所需形状和尺寸的金属构件。", `name`: "钣金加工工艺", `pro_所需环境`: "null", `pro_物理化学`: "物理", `pro_常见用途`: "null", `pro_工艺编号`: "1.2.2", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
