CREATE (n73:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:164", `pro_工艺产物`: "具有所需弯曲形状的金属零件", `pro_所需设备`: "折弯机、模具、刀具", `pro_父工艺`: "弯曲工艺", `pro_常见异常`: "弯曲角度不准确、金属材料出现裂纹", `pro_工艺描述`: "通过机械或液压设备将金属板材弯折成所需的形状。", `name`: "折弯工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "金属箱体、金属框架、金属槽", `pro_工艺编号`: "1.2.2.1.1", `pro_注意事项`: "选择适当的模具和刀具，以获得所需的弯曲形状和尺寸。\n控制折弯机的参数，如施加力量、折弯速度等，以保证一致的工件质量。\n定期检查和维护折弯设备，确保其准确性和稳定性。\n注意金属材料的性质和强度，避免超过其可承受的弯曲限制。\n操作人员应接受相关培训，熟悉操作规程，并遵守安全操作规范", `pro_工艺对象`: "金属板材、管材"});
CREATE (n74:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:165", `pro_工艺产物`: "具有所需弯曲形状的金属零件", `pro_所需设备`: "滚弯机、辊轮", `pro_父工艺`: "弯曲工艺", `pro_常见异常`: "弯曲角度不准确、弯曲半径不均匀、金属材料发生开裂", `pro_工艺描述`: "使用辊轮设备将金属板材卷成圆筒形或弧形。", `name`: "滚弯工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "金属管道、金属圆弧形材料、弯曲的型材", `pro_工艺编号`: "1.2.2.2.2", `pro_注意事项`: "选择适当的辊轮和辅助装置，以获得所需的弯曲形状和尺寸。\n控制滚弯机的参数，如辊轮位置、施加力量等，以保证一致的工件质量。\n定期检查和维护滚弯设备，确保其准确性和稳定性。\n注意金属材料的性质和强度，避免超过其可承受的弯曲限制。\n操作人员应接受相关培训，熟悉操作规程，并遵守安全操作规范。", `pro_工艺对象`: "金属管材、型材"});
CREATE (n75:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:166", `pro_工艺产物`: "null", `pro_所需设备`: "null", `pro_父工艺`: "钣金加工工艺", `pro_常见异常`: "null", `pro_工艺描述`: "通过在金属薄板上施加力和冲击力来形成所需形状。", `name`: "冲压工艺", `pro_所需环境`: "null", `pro_物理化学`: "物理", `pro_常见用途`: "null", `pro_工艺编号`: "1.2.2.2", `pro_注意事项`: "null", `pro_工艺对象`: "null"});
CREATE (n76:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:167", `pro_工艺产物`: "具有孔洞的金属零件", `pro_所需设备`: "冲床、冲头、冲模", `pro_父工艺`: "冲压工艺", `pro_常见异常`: "冲孔位置偏移、孔洞变形、冲床卡死", `pro_工艺描述`: "用于在金属板材上制作孔洞。", `name`: "冲孔工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "金属构件的连接、通风孔、排水孔、装配孔", `pro_工艺编号`: "1.2.2.2.1", `pro_注意事项`: "选择适当的冲头和冲模,以获得所需的孔洞形状和尺寸。\n控制冲床的参数,如冲程、冲击力等,以确保准确的冲孔结果。 定期检查和维护冲床和冲模具,确保其准确性和稳定性。\n注意金属材料的性质和厚度,避免超过其可承受的冲孔限制。\n操作人员应接受相关培训,熟悉操作规程,并遵守安全操作规范。", `pro_工艺对象`: "金属板材、金属管材、金属型材"});
CREATE (n77:`Instance` {`neo4j_id`: "4:845a2a8e-fc6c-4c47-8432-913fc44ff075:168", `pro_工艺产物`: "具有指定凹凸表面的工件", `pro_所需设备`: "压花机、压花模具", `pro_父工艺`: "冲压工艺", `pro_常见异常`: "花纹不清晰、材料损坏、深浅不均匀", `pro_工艺描述`: "用于在金属板材上制作凹凸部分。", `name`: "压花工艺", `pro_所需环境`: "通风良好\n室温\n常压", `pro_物理化学`: "物理", `pro_常见用途`: "外壳表面装饰", `pro_工艺编号`: "1.2.2.2.2", `pro_注意事项`: "选择适当的压花模具和工艺参数，以获得所需的纹理效果。\n控制压花机的压力、温度等参数，确保良好的压花效果。\n定期检查和维护压花设备和模具，确保其准确性和稳定性。\n注意材料的性质和厚度，避免过度压花或材料损坏。\n操作人员应接受相关培训，熟悉操作规程，并遵守安全操作规范。", `pro_工艺对象`: "金属板材、金属型材、塑料制品、皮革制品"});
